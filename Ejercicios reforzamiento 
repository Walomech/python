#Ejercicio 1 ADIVINA EL NUMERO CON INTENTOS LIMITADOS

import random
numero = random.randint(1,50)
intentos = 0
print("BIENVENIDO AL JUEGO")
print("Tienes que adivinar el numero entre 1 y 50" )
while intentos <5:
    adivina = int(input("Introduce tu numero: "))
    if adivina < numero:
        print("El numero es mayor")
    elif adivina > numero:
        print("El numero es menor")
    else:
        print("Felicidades, has adivinado el numero!")
        print("El numero era:", numero)
        print("Lo lograste en", intentos+1, "intentos.")
        print("Gracias por jugar.")       
        break
    intentos += 1
if intentos == 5:
    print("Lo siento, has agotado tus intentos. El numero era:", numero)

#Ejercicio 2 NUMERO SECRETO AJUSTADO
import random
base = random.randint(10,99)
print("BIENVENIDO AL JUEGO")
print("Tienes que adivinar el numero entre 10 y 99" )
secreto=(base *2)+7-(base % 5)
intentos = 0
while intentos <3:
    adivina= int(input("Introduce tu numero: "))
    intentos += 1
    if adivina!=secreto:
        print("Numero incorrecto, intenta de nuevo.")
    if adivina == secreto:
        print("Felicidades, has adivinado el numero!")
        print("El numero era:", secreto)
        print("Lo lograste en", intentos, "intentos.")
        print("Gracias por jugar.")       
        break
    elif intentos ==2:
        print("Te dare una pista: la base del numero secreto es:", base)
if intentos == 3:
    print("No has adivinado el numero, gracias por jugar.")
    print("El numero secreto era:", secreto)
    print("Su formula es: (base *2)+7-(base % 5)")

