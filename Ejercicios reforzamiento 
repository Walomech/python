#Ejercicio 4 Recargo aleatorio por tarjeta de credito
import random
monto = int(input("Ingrese el monto de su compra :"))
recargo = random.randint(1,12)
valor_recargo = 0
if recargo == 1:
    print("Recargo por tarjeta de credito: 0%")
    total = monto 
elif recargo >=2 and recargo <=3:
    print("Recargo por tarjeta de credito: 3%")
    valor_recargo = monto * 0.03
    total = monto + valor_recargo
elif recargo >=4 and recargo <=6:
    print("Recargo por tarjeta de credito: 8%")
    valor_recargo = monto * 0.08
    total = monto + valor_recargo
elif recargo >=7 and recargo <=9:
    print("Recargo por tarjeta de credito: 14%")
    valor_recargo = monto * 0.14
    total = monto + valor_recargo
elif recargo >=10 and recargo <=12:
    print("Recargo por tarjeta de credito: 22%")
    valor_recargo = monto * 0.22
    total = monto + valor_recargo
print("El monto de su compra es:", monto)
print("El recargo por tarjeta de credito es:", valor_recargo)
print("El monto total a pagar es:", total)



#Ejercicio 5 Calculadora de IVA
import random

print("CALCULADORA DE IVA CON 5 PRECIOS ALEATORIOS")
print("=" * 80)
print(f"{'Neto':>10} | {'IVA (19%)':>10} | {'Cargo/Desc':>12} | {'Total':>10}")
print("=" * 80)

total_acumulado = 0

for i in range(5):
    neto = random.randint(1000, 50000)
    iva = neto * 0.19
    ajuste = 0
    
    if neto < 5000:
        # IVA 19% solamente
        ajuste = 0
        precio_final = neto + iva
    elif neto >= 5000 and neto < 20000:
        # IVA 19% + cargo servicio 2%
        cargo_servicio = neto * 0.02
        ajuste = cargo_servicio
        precio_final = neto + iva + cargo_servicio
    else:
        # IVA 19% + descuento 5%
        descuento = neto * 0.05
        ajuste = -descuento
        precio_final = neto + iva - descuento
    
    total_acumulado += precio_final
    print(f"${neto:>9} | ${iva:>9.2f} | ${ajuste:>11.2f} | ${precio_final:>9.2f}")

print("=" * 80)
print(f"TOTAL ACUMULADO: ${total_acumulado:.2f}")